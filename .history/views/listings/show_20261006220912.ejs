
<% layout("/layout/boilerplate") -%>

<div class="row mt-4">
    <div class="col-md-8 offset-md-2">

        <h3 class="mb-3"><%= listing.title %></h3>

        <div class="card">
            <img
                src="<%= listing.image && listing.image.url
                    ? listing.image.url
                    : 'https://tse2.mm.bing.net/th/id/OIP.hx9kvoHQqY64hoKA7fzwQgHaDu?r=0&rs=1&pid=ImgDetMain&o=7&rm=3' %>"
                class="card-img-top"
                alt="<%= listing.title %>"
                style="height: 350px; width: 100%; object-fit: cover;"
                onerror="this.onerror=null; this.src='https://tse2.mm.bing.net/th/id/OIP.hx9kvoHQqY64hoKA7fzwQgHaDu?r=0&rs=1&pid=ImgDetMain&o=7&rm=3';"
            >

            <div class="card-body">
                <p class="card-text">
                    <strong>Description:</strong>
                    <%= listing.description %>
                </p>

                <p class="card-text">
                    <strong>Price:</strong>
                    &#8377;<%= Number(listing.price).toLocaleString("en-IN") %>
                </p>

                <p class="card-text">
                    <strong>Location:</strong>
                    <%= listing.location %>
                </p>

                <p class="card-text">
                    <strong>Country:</strong>
                    <%= listing.country %>
                </p>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <a
                href="/listing/<%= listing._id %>/edit"
                class="btn btn-dark"
            >
                Edit Listing
            </a>

            <a href="/listing" class="btn btn-outline-dark">
                Back to Listings
            </a>

            <form
                method="POST"
                action="/listing/<%= listing._id %>?_method=DELETE"
            >
                <button class="btn btn-danger" type="submit">
                    Delete Listing
                </button>
            </form>
        </div>

    </div>
</div>