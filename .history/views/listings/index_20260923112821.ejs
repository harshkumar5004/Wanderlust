
<% layout("/layout/boilrtplate") %>

<h3>All Listings</h3>

<form method="GET" action="/listing/new">
    <button>Create New</button>
</form>

<ul>
    <% for (let listing of allListing) { %>
        <li>
            <a href="/listing/<%= listing._id %>">
                <%= listing.title %>
            </a>
        </li>
    <% } %>
</ul>

