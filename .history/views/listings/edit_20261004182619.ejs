<% layout("/layout/boilerplate") -%>

<h3>Edit Listing</h3>

<!-- Update Form -->
<form
    method="POST"
    action="/listing/<%= listing._id %>?_method=PUT"
>

    <!-- Title -->
    <div class="mb-3">
        <label for="title" class="form-label">Title</label>

        <input
            type="text"
            id="title"
            name="listing[title]"
            value="<%= listing.title %>"
            placeholder="Enter title"
            class="form-control"
        >
    </div>


    <!-- Description -->
    <div class="mb-3">
        <label for="description" class="form-label">
            Description
        </label>

        <textarea
            id="description"
            name="listing[description]"
            placeholder="Enter description"
            class="form-control"
            rows="4"
        ><%= listing.description %></textarea>
    </div>


    <!-- Image URL -->
    <div class="mb-3">
        <label for="image" class="form-label">
            Image URL
        </label>

        <input
            type="text"
            id="image"
            name="listing[image][url]"
            value="<%= listing.image?.url || '' %>"
            placeholder="Enter image URL"
            class="form-control"
        >
    </div>


    <!-- Price + Location + Country -->
    <div class="row">

        <!-- Price -->
        <div class="mb-3 col-md-4">
            <label for="price" class="form-label">
                Price
            </label>

            <input
                type="number"
                id="price"
                name="listing[price]"
                value="<%= listing.price %>"
                placeholder="Enter price"
                class="form-control"
            >
        </div>


        <!-- Location -->
        <div class="mb-3 col-md-4">
            <label for="location" class="form-label">
                Location
            </label>

            <input
                type="text"
                id="location"
                name="listing[location]"
                value="<%= listing.location %>"
                placeholder="Enter location"
                class="form-control"
            >
        </div>


        <!-- Country -->
        <div class="mb-3 col-md-4">
            <label for="country" class="form-label">
                Country
            </label>

            <input
                type="text"
                id="country"
                name="listing[country]"
                value="<%= listing.country %>"
                placeholder="Enter country"
                class="form-control"
            >
        </div>

    </div>


    <!-- Update Button -->
    <button type="submit" class="btn btn-dark">
        Update Listing
    </button>

</form>


<!-- Delete Form -->
<form
    method="POST"
    action="/listing/<%= listing._id %>?_method=DELETE"
    class="mt-3"
>

    <button type="submit" class="btn btn-danger">
        Delete Listing
    </button>

</form>