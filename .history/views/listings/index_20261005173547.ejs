<% layout("/layout/boilerplate") -%>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">

    <% for (let listing of allListing) { %>

        <div class="col">

            <div class="card h-100">

                <a href="/listing/<%= listing._id %>">
                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top"
                        alt="listing_image"
                        style="height: 15rem"
                    >
                </a>

                <div class="card-body">

                    <h5 class="card-title">
                        <%= listing.title %>
                    </h5>

                    <p class="card-text">
                        ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %>
                        / night
                    </p>

                    <a
                        href="/listing/<%= listing._id %>"
                        class="btn btn-primary"
                    >
                        Go
                    </a>

                    <!-- Delete button -->
                    <form
                        method="POST"
                        action="/listing/<%= listing._id %>?_method=DELETE"
                        style="display: inline;"
                    >
                        <button
                            type="submit"
                            class="btn btn-danger"
                        >
                            Delete
                        </button>
                    </form>

                </div>

            </div>

        </div>

    <% } %>

</div>